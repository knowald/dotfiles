#!/usr/bin/env python3
"""Rejoin hard-wrapped lines in the clipboard (e.g. text copied from a terminal).

Keeps paragraph breaks, list items, headings, tables, quotes, tree lines and
fenced code blocks. Prints the result and puts it back on the clipboard.
Pass -n to only print.
"""
import os
import re
import subprocess
import sys

BLOCK_START = re.compile(r"([-*+]|\d+[.)])[ \t]|#|\||>|[├└│•]")
FENCE = re.compile(r"(`{3,}|~{3,})")
URL_END = re.compile(r"https?://\S*$")


def shared_indent(lines):
    indents = [re.match(r"[ \t]*", line).group() for line in lines if line.strip()]
    return os.path.commonprefix(indents) if indents else ""


def unwrap(text):
    lines = text.splitlines()
    indent = shared_indent(lines)
    widest = max((len(line.rstrip()) for line in lines), default=0)
    output = []
    paragraph = None
    previous = ""
    fence = None

    def flush():
        nonlocal paragraph
        if paragraph is not None:
            output.append(paragraph)
            paragraph = None

    for raw in lines:
        line = raw[len(indent):] if raw.startswith(indent) else raw.lstrip(" \t")
        content = line.strip(" \t")

        if fence:
            output.append(line)
            if re.fullmatch(re.escape(fence[0]) + "{%d,}" % len(fence), content):
                fence = None
            continue

        opening = FENCE.match(content)
        if opening:
            flush()
            output.append(line)
            fence = opening.group(1)
            continue

        line = line.rstrip()
        if not content:
            flush()
            output.append("")
            continue

        # Headings and table rows never continue onto the next line
        if paragraph is None or BLOCK_START.match(content) or re.match(r"[ \t]*[#|]", paragraph):
            flush()
            paragraph = line
        elif URL_END.search(paragraph) and len(previous.rstrip()) >= widest - 1:
            # A URL that ran into the terminal edge (the widest line) continues
            # without a space
            paragraph += content
        else:
            paragraph += " " + content
        previous = raw

    flush()
    result = "\n".join(output)
    if text.endswith(("\n", "\r")):
        result += "\n"
    return result


def main():
    clipboard = subprocess.run(["pbpaste"], capture_output=True, text=True, check=True).stdout
    result = unwrap(clipboard)
    sys.stdout.write(result if result.endswith("\n") else result + "\n")
    if "-n" not in sys.argv[1:]:
        subprocess.run(["pbcopy"], input=result, text=True, check=True)


if __name__ == "__main__":
    main()
