{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "attribution": false,
  "spinnerTipsEnabled": false,
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh '🔔 Claude Code' 'Claude needs your input' Ping"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh '✅ Claude Code' 'Task completed' Funk"
          }
        ]
      }
    ]
  }
}
